   {"mm": [54.8, 324.5, 96.5, 329.5], "text": "Output Level"},
   {"mm": [143.1, 324.7, 204.9, 329.8], "text": "+30 dBm max imum."},
   {"mm": [55.1, 311.3, 122.6, 316.4], "text": "Power Requirements:"},
   {"mm": [157.6, 311.5, 163.7, 316.6], "text": "21"},
   {"mm": [176.4, 311.5, 300.7, 316.6], "text": "vo ts dc, 18 mA quiescent current."},
   {"mm": [143.4, 304.9, 231.0, 309.9], "text": "65 mA at +30 dBm output."},
   {"mm": [55.1, 291.5, 126.9, 296.5], "text": "Amb ient Temperature:"},
   {"mm": [151.1, 291.5, 223.0, 296.5], "text": "to 60 degrees Celsius"},
   {"mm": [55.1, 278.3, 92.6, 283.3], "text": "Dimensions:"},
   {"mm": [143.6, 278.3, 159.6, 283.3], "text": "3.25\""},
   {"mm": [172.3, 278.3, 188.3, 283.3], "text": "3.38\""},
